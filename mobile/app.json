{
  "expo": {
    "name": "MyWatchedLists",
    "slug": "mywatchedlists",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mywatchedlists",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "android": {
      "package": "com.mywatchedlists.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d4f20887-43e6-4712-88fd-705c7edf3ae1"
      }
    },
    "owner": "sanu-s-10"
  }
}
