# Backend API Base URL
# Physical Android device on same Wi-Fi: http://<YOUR_LAN_IP>:5000 (e.g., http://192.168.1.100:5000)
# Android Emulator on same machine: http://10.0.2.2:5000
# Production server: https://api.mywatchedlists.example.com
EXPO_PUBLIC_API_URL=http://<YOUR_SERVER_IP_OR_DOMAIN>:5000

# TMDB Public API Key (Client-side movie/series search & poster display)
# Obtain your free API key at https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
